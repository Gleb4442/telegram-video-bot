# =========================================================
# Telegram Bot Configuration
# =========================================================
# Required: Obtain your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Required: Secret token to authenticate Telegram webhook payloads (A-Z, a-z, 0-9, _, -)
# Choose a strong random string (e.g. openssl rand -hex 24)
TELEGRAM_SECRET_TOKEN=a_super_secret_token_change_me_12345

# =========================================================
# Scraper & Downloader APIs
# =========================================================
# Optional: Cobalt instance URL (defaults to: https://cobalt-service-gleb.onrender.com/)
COBALT_API_URL=https://cobalt-service-gleb.onrender.com/

# Optional: Fallback Cobalt instances separated by comma (defaults to: https://rue-cobalt.xenon.zone/)
COBALT_FALLBACK_URLS=https://rue-cobalt.xenon.zone/

# Optional: Cobalt API key if using an authenticated self-hosted instance
COBALT_API_KEY=

# Optional: Environment mode ('development' | 'production' | 'test')
NODE_ENV=development
