{
  "name": "telegram-video-bot",
  "version": "1.0.0",
  "description": "Serverless Telegram bot for downloading TikTok, Instagram Reels, and YouTube Shorts without watermarks on Vercel",
  "type": "module",
  "main": "api/webhook.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx scripts/dev-polling.ts",
    "set-webhook": "tsx scripts/set-webhook.ts",
    "delete-webhook": "tsx scripts/delete-webhook.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@grammyjs/types": "5.0.0",
    "@upstash/redis": "^1.39.0",
    "dotenv": "^16.4.7",
    "grammy": "^1.34.0",
    "inngest": "^4.24.0",
    "ipaddr.js": "^2.5.0",
    "undici": "^8.12.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "source-map-js": "^1.2.2",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@5": "^5.0.12"
    }
  }
}
